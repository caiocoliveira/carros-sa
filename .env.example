# Copie para .env e preencha. NÃO commitar o .env.
ANTHROPIC_API_KEY=sk-ant-...

# Opcional — override do caminho do SQLite (default: carros_sa.db no cwd)
# CARROS_SA_DB=/caminho/para/carros_sa.db

# Auto Avaliar — credenciais de login (b2b.autoavaliar.com.br)
# AUTOAVALIAR_EMAIL=seuemail@exemplo.com
# AUTOAVALIAR_PASSWORD=sua_senha_aqui
# AUTOAVALIAR_COOKIES_PATH=/Users/voce/.secrets/autoavaliar_cookies.json

# Google Sheets — exportador de triagem para parceiros
# GOOGLE_SHEETS_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms
# GOOGLE_SERVICE_ACCOUNT_PATH=/Users/voce/.secrets/carros-sa-sheets.json

# Google Drive — pasta onde subimos os PDFs de laudo (link permanente na planilha).
# Crie uma pasta no Drive, compartilhe com o e-mail da service account (papel
# Editor) e cole o ID da pasta abaixo (extraído da URL do Drive).
# Sem esta variável o pipeline continua funcionando, mas a coluna Laudo cai pra
# URL pré-assinada do Auto Avaliar (que expira em ~1h após a triagem).
# GOOGLE_DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# LLM providers (opcionais — default é Gemini; auto faz fallback se Anthropic key existir)
# VISION_PROVIDER=gemini   # gemini | anthropic | ollama | auto
# TEXT_LLM_PROVIDER=gemini # gemini | anthropic | ollama | ollama+gemini | auto
#
# Ollama local (Gemma 3 4B no MacBook Air) — requer `ollama serve` + `ollama pull gemma3:4b`
# TEXT_LLM_PROVIDER=ollama+gemini   # Ollama primário, Gemini como safety net
